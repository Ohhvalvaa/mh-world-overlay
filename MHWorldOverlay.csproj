<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MHWorldOverlay</AssemblyName>
    <RootNamespace>MHWorldOverlay</RootNamespace>
    <Version>1.0.1</Version>
    <Product>MH World Overlay</Product>
    <Authors>Ohhvalvaa</Authors>
  </PropertyGroup>
  <!-- Nella DLL di release niente informazioni di debug: conterrebbero il percorso locale del PC che compila. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SharpPluginLoader.Core" Version="2.0.0" />
  </ItemGroup>
</Project>
